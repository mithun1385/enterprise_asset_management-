{
  "name": "EAM",
  "version": "1.0.0",
  "description": "Enterprise Asset Management — single CAP + Fiori Elements app",
  "private": true,
  "workspaces": [
    "app/eam"
  ],
  "sapux": [
    "app/eam"
  ],
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-eam": "cds watch --open eam/webapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/eam.db"
        }
      }
    }
  }
}